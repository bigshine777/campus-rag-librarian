# Supabase (Connect > Direct Connection タブの Connection pooling / Transaction で確認できる値)
# パスワードに @ % など特殊文字が入るとURL形式では解析が壊れるため個別に持つ
# Direct connection (db.xxx.supabase.co) はIPv6のみでGitHub Actionsから届かないため、
# IPv4対応のConnection Pooler (aws-0-xxx.pooler.supabase.com) を使う
SUPABASE_DB_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=

# Azure OpenAI (Foundry の Southeast Asia プロジェクト)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=512
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini

# Google Drive (サービスアカウントの鍵ファイル。secrets/配下に置きgitには含めない)
# 複数フォルダを見る場合はカンマ区切りで並べる。各フォルダをサービス
# アカウントのメールアドレスに閲覧者として共有しておくこと。
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_DRIVE_INBOX_FOLDER_IDS=folder-id-1,folder-id-2

# チャットUI (共有パスワード方式)
APP_PASSWORD=

# Notion (Internal Integration Secret。対象データベースに接続を追加しておく)
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=your-data-source-id
APP_USER_PROFILE=氏名: 山田太郎。所属: ○○大学 ○○学科 ○回生。
